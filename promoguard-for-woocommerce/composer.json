{
  "name": "promoguard/promoguard-for-woocommerce",
  "description": "Campaign-level eligibility controls for native WooCommerce coupons.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1 <8.5"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "autoload": {
    "psr-4": {
      "PromoGuard\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PromoGuard\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "@php tools/php-lint.php",
    "lint:phpcs": "phpcs",
    "analyse": "phpstan analyse",
    "test:unit": "phpunit --testsuite unit",
    "check": [
      "@lint:php",
      "@lint:phpcs",
      "@analyse",
      "@test:unit"
    ]
  }
}
